# Create API Key https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# LLM provider: 'gemini' or an OpenAI-compatible name: 'openai', 'openrouter', 'zai', 'nvidia'/'nim',
# 'ollama'.
# Default: gemini
LLM_PROVIDER=gemini

# API key for the selected LLM provider. If not set, uses GEMINI_API_KEY for Gemini provider.
LLM_API_KEY=

# API key for NVIDIA NIM — https://build.nvidia.com (LLM_PROVIDER=nvidia).
NVIDIA_API_KEY=

# API key for z.ai GLM models — https://z.ai (LLM_PROVIDER=zai).
ZAI_API_KEY=

# API key for OpenRouter (LLM_PROVIDER=openrouter).
OPENROUTER_API_KEY=

# Base URL for OpenAI-compatible APIs — overrides the provider preset when set.
LLM_BASE_URL=

# Model name to use. If not set, uses provider-specific defaults.
LLM_MODEL=

# Enable request logging for OpenAI provider (logs full request with base64 truncated).
# Default: false
OPENAI_ENABLE_LOGGING=false

# If you use Camoufox, it is recommended to turn off the custom Bessel track generator of hcaptcha-
# challenger and use Camoufox(humanize=True)
# Default: false
DISABLE_BEZIER_TRAJECTORY=false

# Force disable HSW reverse engineering and fallback to visual recognition. Useful for testing the
# fallback branch when HSW decoding fails.
# Default: false
DISABLE_HSW_REVERSE=false

# CRUMB_COUNT: The number of challenge rounds you need to solve once the challenge starts.
# In the vast majority of cases this value will be 2, some specialized sites will set this value to 3.
# In most cases you don't need to change this value, the `_review_challenge_type` task determines the
# exact value of `CRUMB_COUNT` based on the information of the assigned task.
# Only manually change this value if you are working on a very specific task that prevents the
# `_review_challenge_type` from hijacking the task information and the maximum number of tasks > 2.
# Default: 2
MAX_CRUMB_COUNT=2

# When your local network is poor, increase this value appropriately [unit: second]
# Default: 120
EXECUTION_TIMEOUT=120

# When your local network is poor, increase this value appropriately [unit: second]
# Default: 30
RESPONSE_TIMEOUT=30

# Re-execute the challenge when it fails
# Default: true
RETRY_ON_FAILURE=true

# When your local network is poor, increase this value appropriately [unit: millisecond]
# Default: 1500
WAIT_FOR_CHALLENGE_VIEW_TO_RENDER_MS=1500

# Maximum number of challenges to attempt before aborting (credit protection)
# Default: 10
MAX_CHALLENGES=10

# Max pixel distance for snapping LLM drag endpoints to known entity centers from the captcha payload
# [unit: pixel]
# Default: 80
ENTITY_SNAP_RADIUS=80

# Per-request timeout for LLM API calls [unit: second]
# Default: 90.0
LLM_REQUEST_TIMEOUT=90.0

# Run a self-verification pass on drag predictions: render proposed paths onto the challenge image and
# let the model confirm or correct them
# Default: true
VERIFY_DRAG_PATHS=true

# Use HTML5 Drag and Drop API instead of mouse simulation for drag challenges
# Default: false
USE_HTML5_DRAG=false

# Use Pointer Events API (pointerdown/move/up) instead of mouse simulation for drag challenges
# Default: false
USE_POINTER_EVENTS=false

# For the challenge classification task
# Used as last resort when HSW decoding fails.
# Default: gemini-3.7-flash
CHALLENGE_CLASSIFIER_MODEL=gemini-3.7-flash

# For the challenge type: `image_label_binary`
# Default: gemini-3.7-flash
IMAGE_CLASSIFIER_MODEL=gemini-3.7-flash

# For the challenge type: `image_label_area_select` (single/multi)
# Default: gemini-3.7-flash
SPATIAL_POINT_REASONER_MODEL=gemini-3.7-flash

# For the challenge type: `image_drag_drop` (single/multi)
# Default: gemini-3.7-flash
SPATIAL_PATH_REASONER_MODEL=gemini-3.7-flash